	(text
		"USB CABLE CHECKER"
		(exclude_from_sim no)
		(at 20 20 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "1a541ec7-75f8-4c25-8e99-a99d9ee4677c")
	)
	(text
		"Source side: every contact of J1-J3 is tied to VTEST.  Sink side: every contact of J4-J9 drives its own LED + 1k to GND.\nPlug one end of a cable into a SOURCE connector and the other end into a SINK connector: each LED that lights = one conductor present.\nWARNING: never connect the checker to a real device or charger - all source contacts (incl. GND/shield) sit at VTEST."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "e89f819f-7c3b-4a44-8729-137c9c4fda6f")
	)
	(text
		"POWER  (3 V CR2032  or  3-12 V external -> AMS1117-3.3 LDO)"
